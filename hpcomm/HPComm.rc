IDD_ARCHIVENAME DIALOGEX 0, 0, 170, 151
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Archive name"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_ARCHIVENAME,14,30,124,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,37,130,27,14
    PUSHBUTTON      "Cancel",IDCANCEL,85,130,27,14
    LTEXT           "Enter the name of the backup file:",IDC_STATIC,14,16,
                    102,8
    LTEXT           "Press OK, then press:",IDC_STATIC,14,51,80,8
    LTEXT           "EVAL\nrshift + P",IDC_STATIC,20,62,46,18
    LTEXT           "on the HP48 series\non the HP49G",IDC_STATIC,70,61,64,
                    19
    GROUPBOX        "",IDC_STATIC,7,7,156,116
    LTEXT           "to start the backup.",IDC_STATIC,14,83,136,8
    LTEXT           "NB: The HP49G must be in RPN mode.  If\nyou need to change it, ensure you restart server mode.",
                    IDC_STATIC,14,94,143,25
END

IDD_CAPTURE DIALOG DISCARDABLE  0, 0, 189, 194
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Screenshot"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Make sure the calculator is properly connected to the PC\nand that the settings are OK.\n\nLeave server mode by pressing the ON key, then\ngo to the desired screen on the calculator.\n\n(If you're using a HP48S(X), execute PR1 once)",
                    IDC_STATIC,14,7,167,65
    LTEXT           "\non the HP 48 S(X)\n\non the HP 48 G(X)\n\non the HP 49G",
                    IDC_STATIC,70,76,77,51
    LTEXT           "Press:\nOn + [MTH]\n\nOn + 1\n\nOn + up-arrow",
                    IDC_STATIC,14,76,56,50
    LTEXT           "The transfer will begin automatically.",IDC_STATIC,14,
                    135,167,11
    GROUPBOX        "",IDC_STATIC,7,69,174,62
    PUSHBUTTON      "Cancel",IDCANCEL,76,150,50,14
    LTEXT           "If you're having problems, please refer to the\nonline help section for important information.",
                    IDC_STATIC,14,168,165,19
END

