//
// Menu
//

IDR_GROBVIEW MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save as...",                 IDC_SAVE
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy to clipboard",          IDC_COPY
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Reload",                     IDC_RELOAD
        POPUP "Reload &GROB as"
        BEGIN
            MENUITEM "&B/W GROB",                   ID_BWGROB
            MENUITEM "&Grayscale GROB",             ID_GRAYGROB
        END
        MENUITEM SEPARATOR
        MENUITEM "&Mirror",                     IDC_MIRROR
        MENUITEM "&Flip",                       IDC_FLIP
        MENUITEM "Ro&tate",                     IDC_ROTATE
        MENUITEM "&Invert",                     IDC_INVERT
        MENUITEM SEPARATOR
        MENUITEM "M&agnify",                    IDC_MAGNIFY
        MENUITEM "&Shrink",                     IDC_SHRINK
        POPUP "Resi&ze to"
        BEGIN
            MENUITEM "&Standard size",              ID_STANDARDSIZE
            MENUITEM "&Custom size",                ID_CUSTOMSIZE
        END
#if 0
        POPUP "&Convert to"
        BEGIN
            MENUITEM "&Monochrome image",           ID_MONOCHROMEIMAGE
            MENUITEM "&Grayscale image",            ID_GRAYSCALEIMAGE
        END
#endif
        MENUITEM SEPARATOR
        MENUITEM "&With border",                ID_BORDERADD
        POPUP "&Border style"
        BEGIN
            MENUITEM "&Thick",                      ID_BORDERTHICK
            MENUITEM "Th&in",                       ID_BORDERTHIN
        END
        POPUP "Border co&lor"
        BEGIN
            MENUITEM "&White",                      ID_BORDERWHITE
            MENUITEM "&Black",                      ID_BORDERBLACK
        END
    END
END

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "New &Folder",                 ID_FILE_NEWFOLDER
        MENUITEM "&Open in Explorer",           ID_FILE_OPEN
        MENUITEM "Ren&ame",                     ID_RENAME
        MENUITEM "&Delete",                     ID_DELETE
        MENUITEM "&Properties...",              ID_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "Set &38G Folder",             ID_FILE_SET38GFOLDER, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Set &bookmark",               ID_BOOKMARK
        MENUITEM "",                            ID_FILE_MRU_FILE1
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT, GRAYED
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
        MENUITEM "&Select all",                 ID_SELECTALL
    END
    POPUP "&Calculator"
    BEGIN
        MENUITEM "Comm &settings...",           ID_COMMSET
        POPUP "&Protocol", GRAYED
        BEGIN
            MENUITEM "&XModem",                     ID_CALCULATOR_XMODEM
            MENUITEM "&Kermit",                     ID_CALCULATOR_KERMIT
            , CHECKED
        END
        POPUP "&Mode"
        BEGIN
            MENUITEM "&ASCII",                      ID_ASCII, CHECKED
            MENUITEM "&Binary",                     ID_BINARY
        END
        POPUP "&Archive"
        BEGIN
            MENUITEM "&Backup...",                  ID_CALCULATOR_BACKUP
            MENUITEM "&Restore",                    ID_CALCULATOR_RESTORE
        END
        MENUITEM "&Capture Image...",           ID_CAPTURE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
#if 0
        MENUITEM "&Viewer Setup...",            ID_VIEW_SETUP, GRAYED
#endif
        MENUITEM "&Refresh",                    ID_REFRESH
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",                   ID_HELP_FINDER
        MENUITEM "&Index",                      ID_HELP_INDEX
        MENUITEM "Choose help language...",     ID_HELPLANGUAGE
        MENUITEM "&License",                    ID_HELP_LICENSE
        MENUITEM SEPARATOR
        MENUITEM "&About this program...",      ID_APP_ABOUT
    END
END

IDR_CALCPOPUP MENU DISCARDABLE 
BEGIN
    POPUP "CalcPopup"
    BEGIN
        MENUITEM "&Copy",                       ID_EDIT_COPY
        MENUITEM "&Paste",                      ID_EDIT_PASTE
        MENUITEM "&Delete",                     ID_DELETE
    END
END


