/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 256, 98
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About HPComm38"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,21,20
// FIXME: Do a SetText in the dialog code using data from Version.h,
// so the version number's not hardcoded.
    LTEXT           "HPComm38 1.0r4\n\nCopyright (C) 2000 HP and James Bergamin.\n\nThis software licensed under the GNU GPL:",
                    IDC_STATIC,40,10,153,42,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,199,7,50,14,WS_GROUP
    LTEXT           "For the source code and other goodies visit:",
                    IDC_STATIC,40,64,138,8
    LTEXT           "GNU General Public License",IDC_GPL,40,52,74,8
    LTEXT           "http://www.hpcomm.org",IDC_WWWHPCOMM,40,75,78,8
END

IDD_GROBVIEW DIALOGEX 0, 0, 131, 77
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Image Viewer"
MENU IDR_GROBVIEW
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_GROB,"Static",SS_BITMAP | SS_NOTIFY | SS_SUNKEN,3,
                    3,19,17,WS_EX_CLIENTEDGE
END

IDD_HELPFILEDLG DIALOGEX 0, 0, 131, 126
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Help File..."
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,105,35,14
    PUSHBUTTON      "Cancel",IDCANCEL,89,105,35,14
    LISTBOX         IDC_HELPFILES,7,41,117,54,LBS_SORT | 
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Please select the language\nof your help file.",
                    IDC_STATIC,7,7,117,21
    LTEXT           "These languages were found:",IDC_STATIC,7,28,95,8
END

IDD_HPCOMM38_DIALOG DIALOGEX 0, 0, 247, 234
STYLE DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | 
    WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "HPComm38"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Change Directory...",IDC_CHANGEDIR,151,108,73,14,
                    WS_GROUP
    COMBOBOX        IDC_COMPORT,55,125,46,63,CBS_DROPDOWNLIST | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_DIRECTORY,19,108,126,14,ES_AUTOHSCROLL | 
                    ES_WANTRETURN | NOT WS_TABSTOP
    LTEXT           "Serial Port:",IDC_STATIC,19,128,34,8
    CONTROL         336,IDC_STATIC,"Static",SS_BITMAP | SS_SUNKEN,19,16,94,
                    84,WS_EX_STATICEDGE
    LTEXT           "To begin transmission, press SEND or RECV on the calculator.\n\nTo capture an image of the screen, press ON + 1.",
                    IDC_STATIC,125,16,94,84,NOT WS_GROUP
    PUSHBUTTON      "Show calculator files...",IDC_SHOWVD,151,125,73,14,
                    WS_GROUP
    GROUPBOX        "",IDC_STATIC,7,3,233,143
    EDITTEXT        IDC_INFO,7,162,192,52,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_READONLY | WS_VSCROLL,WS_EX_DLGMODALFRAME | 
                    WS_EX_STATICEDGE
    LTEXT           "Info:",IDC_INFOSTATIC,7,151,15,8
    ICON            IDR_MAINFRAME,IDC_STATIC,209,177,21,20,SS_CENTERIMAGE | 
                    SS_REALSIZEIMAGE
END

IDD_RESIZEDLG DIALOGEX 0, 0, 80, 57
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Resize Image"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,38,25,12
    PUSHBUTTON      "Cancel",IDCANCEL,48,38,25,12
    EDITTEXT        IDC_WIDTH,48,6,25,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "New width:",IDC_STATIC,7,8,36,8
    LTEXT           "New height:",IDC_STATIC,7,23,39,8
    EDITTEXT        IDC_HEIGHT,48,21,25,12,ES_AUTOHSCROLL | ES_NUMBER
END

IDD_TRANSFERINFO DIALOG DISCARDABLE  0, 0, 161, 73
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Sans Serif"
BEGIN
    CTEXT           "\n\nInitializing file transfer....",IDC_INFO,7,7,147,42,
                    SS_SUNKEN
    PUSHBUTTON      "&Close",IDC_CLOSE,62,54,38,12
END

IDD_WAITINFO DIALOGEX 0, 0, 177, 46
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE
EXSTYLE WS_EX_CLIENTEDGE
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CTEXT           "Please wait while the directories are being read...\n\nThis can take a while.",
                    IDC_STATIC,36,7,119,32
    ICON            IDR_MAINFRAME,IDC_STATIC,2,13,21,20
END

IDD_VDDLG DIALOG DISCARDABLE  0, 0, 186, 191
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "38G files"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,67,170,50,14
    CONTROL         "Tree1",IDC_VDTREE,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | 
                    WS_BORDER | WS_TABSTOP,7,7,172,153
END


