IDD_ABOUTBOX DIALOGEX 0, 0, 296, 137
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About HPComm38"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "HPGComm 2.01\n\nCopyright (C) 2001 HP and Jean-Pierre Bergamin.\n\nThis software is licensed under the GNU GPL:",
                    IDC_STATIC,114,12,164,42,SS_NOPREFIX
    DEFPUSHBUTTON   "OK",IDOK,23,105,65,14,BS_FLAT | WS_GROUP
    LTEXT           "For the source code and other goodies visit:",
                    IDC_STATIC,114,64,138,8
    LTEXT           "GNU General Public License",IDC_GPL,114,54,74,8
    LTEXT           "http://www.hpcomm.org",IDC_WWWHPCOMM,114,74,78,8
    CONTROL         284,IDC_STATIC,"Static",SS_BITMAP,9,12,94,84,
                    WS_EX_STATICEDGE
    LTEXT           "Thanks go to Colin Croft for beta-testing.",IDC_STATIC,
                    114,86,128,8
    LTEXT           "Visit his homepage for HP38/39 goodies:",IDC_STATIC,114,
                    99,130,8
    LTEXT           "http://members.iinet.net.au/~ccroft",IDC_COLINGURL,114,
                    110,112,8
    GROUPBOX        "",IDC_STATIC,109,3,179,121
    GROUPBOX        "",IDC_STATIC,2,0,290,128
    GROUPBOX        "",IDC_STATIC,5,3,101,121
END

IDD_GROBVIEW DIALOGEX 0, 0, 131, 77
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Image Viewer"
MENU IDR_GROBVIEW
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_GROB,"Static",SS_BITMAP | SS_NOTIFY | SS_SUNKEN,3,
                    3,19,17,WS_EX_CLIENTEDGE
END

IDD_HELPFILEDLG DIALOGEX 0, 0, 131, 126
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Help File..."
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,105,35,14
    PUSHBUTTON      "Cancel",IDCANCEL,89,105,35,14
    LISTBOX         IDC_HELPFILES,7,41,117,54,LBS_SORT | 
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Please select the language\nof your help file.",
                    IDC_STATIC,7,7,117,21
    LTEXT           "These languages were found:",IDC_STATIC,7,28,95,8
END

IDD_HPCOMM38_DIALOG DIALOGEX 0, 0, 235, 215
STYLE DS_MODALFRAME | DS_CENTER | DS_CONTEXTHELP | WS_POPUP | WS_VISIBLE | 
    WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "HPGComm 2.0"
FONT 8, "MS Sans Serif"
BEGIN
    PUSHBUTTON      "...",IDC_CHANGEDIR,163,105,16,15,BS_ICON | BS_FLAT | 
                    WS_GROUP
    COMBOBOX        IDC_COMPORT,161,78,57,63,CBS_DROPDOWNLIST | CBS_SORT | 
                    WS_VSCROLL | WS_TABSTOP,0,HIDC_COMPORT
    LTEXT           "Serial Port:",IDC_STATIC,121,80,34,8
    CONTROL         336,IDC_CALCPIC,"Static",SS_BITMAP | SS_SUNKEN,14,11,94,
                    84,WS_EX_STATICEDGE
    LTEXT           "To begin transmission, press SEND or RECV on the calculator.",
                    IDC_SENDRECV,121,14,94,28,NOT WS_GROUP
    PUSHBUTTON      "Show calculator files...",IDC_SHOWVD,205,105,16,15,
                    BS_ICON | BS_FLAT | WS_GROUP
    GROUPBOX        "",IDC_STATIC,7,3,221,125
    EDITTEXT        IDC_INFO,7,145,192,53,ES_MULTILINE | ES_AUTOVSCROLL | 
                    ES_READONLY | WS_VSCROLL,WS_EX_DLGMODALFRAME | 
                    WS_EX_STATICEDGE
    ICON            IDR_MAINFRAME,IDC_STATIC,205,177,20,20,SS_CENTERIMAGE | 
                    SS_REALSIZEIMAGE
    PUSHBUTTON      "Create Directory",IDC_CREATEDIR,184,105,16,15,BS_ICON | 
                    BS_FLAT
    PUSHBUTTON      "^^",IDC_HIDEINFO,205,145,20,9,BS_ICON | BS_FLAT
    GROUPBOX        "",IDC_STATIC,113,7,110,64
    GROUPBOX        "",IDC_STATIC,113,70,110,25
    LTEXT           "Info:",IDC_INFOSTATIC,7,134,15,8
    COMBOBOX        IDC_DIRECTORY,14,106,144,83,CBS_DROPDOWN | 
                    CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "To capture an image of the screen, press ON + 1.",
                    IDC_SCREENCAP,121,46,94,21
END

IDD_RESIZEDLG DIALOGEX 0, 0, 80, 57
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Resize Image"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,7,38,25,12
    PUSHBUTTON      "Cancel",IDCANCEL,48,38,25,12
    EDITTEXT        IDC_WIDTH,48,6,25,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "New width:",IDC_STATIC,7,8,36,8
    LTEXT           "New height:",IDC_STATIC,7,23,39,8
    EDITTEXT        IDC_HEIGHT,48,21,25,12,ES_AUTOHSCROLL | ES_NUMBER
END

IDD_TRANSFERINFO DIALOGEX 0, 0, 148, 173
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CTEXT           "\n\nInitializing file transfer....",IDC_INFO,7,36,134,
                    42,SS_SUNKEN
    PUSHBUTTON      "&Cancel",IDC_CLOSE,55,93,38,12
    CONTROL         "Animate1",IDC_ANIMATE,"SysAnimate32",ACS_TRANSPARENT | 
                    WS_TABSTOP,18,7,110,20,WS_EX_TRANSPARENT
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",PBS_SMOOTH,
                    7,83,134,7,WS_EX_STATICEDGE
    GROUPBOX        "Details",IDC_DETAILSGROUP,7,114,134,55
    LTEXT           "Packets:",IDC_STATIC,11,127,29,8
    LTEXT           "CPS:",IDC_STATIC,11,139,17,8
    LTEXT           "Bytes:",IDC_STATIC,74,127,20,8
    RTEXT           "",IDC_PACKETS,45,127,22,8
    RTEXT           "",IDC_CPS,45,139,22,8
    RTEXT           "",IDC_BYTES,113,127,22,8
    PUSHBUTTON      "Details >>>",IDC_DETAILS,98,95,43,10
    LTEXT           "Elapsed:",IDC_STATIC,11,151,28,8
    RTEXT           "",IDC_TIMERUNNING,45,151,22,8
    LTEXT           "BPS:",IDC_STATIC,74,139,17,8
    RTEXT           "",IDC_BPS,113,139,22,8
    LTEXT           "Remaining:",IDC_STATIC,74,151,36,8
    RTEXT           "",IDC_REMAINING,113,151,22,8
    CTEXT           "",IDC_PERCENT,7,93,26,12,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
END

IDD_WAITINFO DIALOGEX 0, 0, 177, 46
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE
EXSTYLE WS_EX_CLIENTEDGE
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    CTEXT           "Please wait while the directories are being read...\n\nThis can take a while.",
                    IDC_STATIC,36,7,119,32
    ICON            IDR_MAINFRAME,IDC_STATIC,2,13,20,20
END

IDD_VDDLG DIALOG DISCARDABLE  0, 0, 186, 194
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "39G files"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "&Close",IDOK,129,166,50,14
    CONTROL         "Tree1",IDC_VDTREE,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | 
                    WS_BORDER | WS_TABSTOP,7,7,172,153
    PUSHBUTTON      "Create virtual directory",IDC_CREATEDIR,7,166,83,14
END

IDD_NEWVD DIALOG DISCARDABLE  0, 0, 186, 61
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New virtual directory"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_NEWNAME,7,19,172,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,28,40,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,108,40,50,14
    LTEXT           "Plese enter the name of the new virtual directory:",
                    IDC_STATIC,7,7,154,8
END


