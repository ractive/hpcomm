/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_GROBVIEW MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save...",                    IDC_SAVE
        MENUITEM "&Open externally",            IDC_OPEN
    END
    MENUITEM "&Copy",                       IDC_COPY
    POPUP "&Options"
    BEGIN
        MENUITEM "&Reload",                     IDC_RELOAD
        POPUP "Reload &GROB as"
        BEGIN
            MENUITEM "&B/W GROB",                   ID_BWGROB
            MENUITEM "&Grayscale GROB",             ID_GRAYGROB
        END
        MENUITEM SEPARATOR
        MENUITEM "&Mirror",                     IDC_MIRROR
        MENUITEM "&Flip",                       IDC_FLIP
        MENUITEM "Ro&tate",                     IDC_ROTATE
        MENUITEM "&Invert",                     IDC_INVERT
        MENUITEM SEPARATOR
        MENUITEM "M&agnify",                    IDC_MAGNIFY
        MENUITEM "&Shrink",                     IDC_SHRINK
        POPUP "Resi&ze to"
        BEGIN
            MENUITEM "&Standard size",              ID_STANDARDSIZE
            MENUITEM "&Custom size",                ID_CUSTOMSIZE
        END
        MENUITEM SEPARATOR
        MENUITEM "&With border\tCtrl+B",        ID_BORDERADD
        POPUP "&Border style"
        BEGIN
            MENUITEM "&Thick",                      ID_BORDERTHICK
            MENUITEM "Th&in",                       ID_BORDERTHIN
        END
        POPUP "Border co&lor"
        BEGIN
            MENUITEM "&White",                      ID_BORDERWHITE
            MENUITEM "&Black",                      ID_BORDERBLACK
        END
    END
END

IDR_MAINFRAME MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Change Directory...",        IDC_CHANGEDIR
        MENUITEM "C&reate Directory...",        IDC_CREATEDIR
        MENUITEM "&Show calculator files...",   IDC_SHOWVD
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Content...",                 ID_HELP_CONTENT
        MENUITEM "&Search",                     ID_HELP_SEARCH
        MENUITEM "Choose help &language...",    ID_HELP_LANGUAGE
        MENUITEM "&About...",                   ID_HELP_ABOUT
    END
END

IDR_TRAY MENU DISCARDABLE 
BEGIN
    POPUP "TrayMenu"
    BEGIN
        MENUITEM "&Restore",                    ID_RESTORE
        MENUITEM "E&xit",                       ID_APP_EXIT
        MENUITEM SEPARATOR
        MENUITEM "&About...",                   ID_HELP_ABOUT
    END
END


